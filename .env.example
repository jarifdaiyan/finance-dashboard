# Postgres connection string (Neon, Vercel Postgres, Supabase, etc).
# Get this from your Neon project dashboard: Connection Details -> copy the "pooled" connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# The password required to log in to the dashboard. Set this to your own secret.
ACCESS_KEY="change-me-to-a-long-random-secret"

# Random secret used to sign the login session cookie. Generate with:
#   openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-secret"
